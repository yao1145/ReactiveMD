{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "reactive-md": ["./src/index.ts"],
      "reactive-md/react": ["./src/react/index.ts"],
      "reactive-md/editor": ["./src/editor/index.ts"],
      "reactive-md/editor/codemirror": ["./src/editor/codemirror/index.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "vite.lib.config.ts", "vite.editor.config.ts", "vite.codemirror.config.ts", "vite.standalone.config.ts", "vitest.config.ts"]
}
