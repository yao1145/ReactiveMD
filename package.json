{
  "name": "reactive-md",
  "version": "0.8.0-next.0",
  "description": "Author interactive local documents in Markdown, with expression-bound inputs, charts and diagrams.",
  "keywords": [
    "markdown",
    "interactive",
    "local-first",
    "reactive",
    "charts",
    "diagrams",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yao1145/ReactiveMD.git"
  },
  "homepage": "https://github.com/yao1145/ReactiveMD#readme",
  "bugs": {
    "url": "https://github.com/yao1145/ReactiveMD/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "files": [
    "dist-library",
    "dist-standalone",
    "bin",
    "cli",
    "README.md",
    "README-en.md",
    "README-ch.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING-ch.md",
    "CHANGELOG.md",
    "CHANGELOG-ch.md",
    "SECURITY.md",
    "SECURITY-ch.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "examples"
  ],
  "bin": {
    "reactive-md": "./bin/reactive-md.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev:lib": "vite build --config vite.lib.config.ts --watch",
    "build": "npm run typecheck && npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.build.config.ts && npm run build:standalone && tsc -p tsconfig.lib.json && node scripts/finalize-declarations.mjs",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --maxWorkers=4",
    "check": "npm run build && npm test && npm run test:boundary && npm run test:compiler-entry",
    "test:boundary": "node scripts/verify-public-package.mjs",
    "test:compiler-entry": "node scripts/verify-compiler-entry.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "prepack": "npm run build && npm run notices"
  },
  "exports": {
    "./vite": {
      "types": "./dist-library/types/vite/index.d.ts",
      "import": "./dist-library/reactive-md-vite.js"
    },
    "./vite/client": {
      "types": "./dist-library/types/vite/client.d.ts"
    },
    "./build": {
      "types": "./dist-library/types/build/index.d.ts",
      "import": "./dist-library/reactive-md-build.js"
    },
    "./compiler": {
      "types": "./dist-library/types/compiler/index.d.ts",
      "import": "./dist-library/reactive-md-compiler.js"
    },
    "./compiler/standard": {
      "types": "./dist-library/types/compiler/standard.d.ts",
      "import": "./dist-library/reactive-md-compiler-standard.js"
    },
    "./testing": {
      "types": "./dist-library/types/testing/index.d.ts",
      "import": "./dist-library/reactive-md-testing.js"
    },
    "./testing/react": {
      "types": "./dist-library/types/testing/react.d.ts",
      "import": "./dist-library/reactive-md-testing-react.js"
    },
    "./testing/browser": {
      "types": "./dist-library/types/testing/browser.d.ts",
      "import": "./dist-library/reactive-md-testing-browser.js"
    },
    "./sdk": {
      "types": "./dist-library/types/sdk/index.d.ts",
      "import": "./dist-library/reactive-md-sdk.js"
    },
    "./presets/default": {
      "types": "./dist-library/types/presets/default.d.ts",
      "import": "./dist-library/reactive-md-default-preset.js"
    },
    "./export": {
      "types": "./dist-library/types/export/index.d.ts",
      "import": "./dist-library/reactive-md-export.js"
    },
    "./standalone": {
      "types": "./dist-library/types/standalone/library.d.ts",
      "import": "./dist-library/reactive-md-standalone-host.js"
    },
    "./react/server": {
      "types": "./dist-library/types/react/server.d.ts",
      "import": "./dist-library/reactive-md-react-server.js"
    },
    ".": {
      "types": "./dist-library/types/index.d.ts",
      "import": "./dist-library/reactive-md.js"
    },
    "./react": {
      "types": "./dist-library/types/react/index.d.ts",
      "import": "./dist-library/reactive-md-react.js"
    },
    "./react/runtime": {
      "types": "./dist-library/types/react/runtime/index.d.ts",
      "import": "./dist-library/reactive-md-react-runtime.js"
    },
    "./runtime": {
      "types": "./dist-library/types/runtime-services/index.d.ts",
      "import": "./dist-library/reactive-md-runtime.js"
    },
    "./styles.css": "./dist-library/reactive-md.css",
    "./react/unstyled": {
      "types": "./dist-library/types/react/index.d.ts",
      "import": "./dist-library/reactive-md-react-unstyled.js"
    },
    "./screen.css": "./dist-library/reactive-md.css",
    "./print.css": "./dist-library/reactive-md-print.css",
    "./authoring": {
      "types": "./dist-library/types/authoring/index.d.ts",
      "import": "./dist-library/reactive-md-authoring.js"
    },
    "./package.json": "./package.json",
    "./notices": "./THIRD_PARTY_NOTICES.md",
    "./assets/standalone.js": "./dist-standalone/reactive-md-standalone.js"
  },
  "peerDependencies": {
    "vite": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lezer/common": "1.5.4",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "elkjs": "0.12.0",
    "highlight.js": "11.11.2",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "parse5": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
