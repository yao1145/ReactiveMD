{
  "name": "reactive-md",
  "version": "0.6.0",
  "description": "Author interactive local documents in Markdown, with expression-bound inputs, charts and diagrams.",
  "keywords": [
    "markdown",
    "interactive",
    "local-first",
    "reactive",
    "charts",
    "diagrams",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yao1145/ReactiveMD.git"
  },
  "homepage": "https://github.com/yao1145/ReactiveMD#readme",
  "bugs": {
    "url": "https://github.com/yao1145/ReactiveMD/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "workspaces": [
    "demo"
  ],
  "files": [
    "dist-library",
    "dist-standalone",
    "bin",
    "cli",
    "README.md",
    "README-en.md",
    "README-ch.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING-ch.md",
    "CHANGELOG.md",
    "CHANGELOG-ch.md",
    "SECURITY.md",
    "SECURITY-ch.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "examples"
  ],
  "bin": {
    "reactive-md": "./bin/reactive-md.mjs"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "npm run build:lib && npm run dev --workspace=@reactive-md/demo",
    "dev:lib": "vite build --config vite.lib.config.ts --watch",
    "build": "npm run typecheck && npm run build:lib",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.editor.config.ts && npm run build:standalone && tsc -p tsconfig.lib.json && node scripts/finalize-declarations.mjs",
    "build:demo": "npm run build && npm run build --workspace=@reactive-md/demo",
    "preview": "npm run preview --workspace=@reactive-md/demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "lint": "node bin/reactive-md.mjs lint",
    "test:components": "vitest run --config vitest.config.ts tests/component-protocol.test.ts tests/conformance.test.ts",
    "test:demo": "npm run build:lib && npm run test --workspace=@reactive-md/demo",
    "test:browser": "npm run test:browser --workspace=@reactive-md/demo",
    "test:browser:core": "node scripts/verify-browser-core.mjs",
    "test:required-browser": "node scripts/verify-required-form-browser.mjs",
    "test:tooltip-browser": "node scripts/verify-tooltip-browser.mjs",
    "test:shareable": "node scripts/verify-shareable.mjs",
    "test:toolbar": "npm run test:toolbar --workspace=@reactive-md/demo",
    "test:package": "node scripts/verify-package.mjs",
    "test:packed": "node scripts/verify-packed.mjs",
    "test:docs": "node scripts/verify-docs.mjs",
    "test:theme-browser": "node scripts/verify-theme-browser.mjs",
    "test:date-browser": "node scripts/verify-date-input-browser.mjs",
    "test:editor-browser": "node scripts/verify-editor-browser.mjs",
    "test:markdown-browser": "node scripts/verify-markdown-browser.mjs",
    "test:math-browser": "node scripts/verify-math-browser.mjs",
    "test:html-browser": "node scripts/verify-html-compat-browser.mjs && node scripts/verify-html-table-browser.mjs",
    "test:media-browser": "node scripts/verify-media-browser.mjs",
    "test:computations-browser": "node scripts/verify-computations-browser.mjs",
    "test:constraints-browser": "node scripts/verify-constraints-browser.mjs",
    "verify:memo": "node scripts/verify-memo-browser.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:release:node": "node scripts/verify-release.mjs --node",
    "verify:release:browser": "node scripts/verify-release.mjs --browser",
    "test:release-browser": "node scripts/verify-release-browser.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:stages": "node scripts/benchmark-stages.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "prepack": "npm run build && npm run notices"
  },
  "exports": {
    ".": {
      "types": "./dist-library/types/index.d.ts",
      "import": "./dist-library/reactive-md.js"
    },
    "./react": {
      "types": "./dist-library/types/react/index.d.ts",
      "import": "./dist-library/reactive-md-react.js"
    },
    "./styles.css": "./dist-library/reactive-md.css",
    "./editor": {
      "types": "./dist-library/types/editor/index.d.ts",
      "import": "./dist-library/reactive-md-editor.js"
    },
    "./editor/styles.css": "./dist-library/reactive-md-editor.css",
    "./react/unstyled": {
      "types": "./dist-library/types/react/index.d.ts",
      "import": "./dist-library/reactive-md-react-unstyled.js"
    },
    "./screen.css": "./dist-library/reactive-md.css",
    "./print.css": "./dist-library/reactive-md-print.css",
    "./authoring": {
      "types": "./dist-library/types/authoring/index.d.ts",
      "import": "./dist-library/reactive-md-authoring.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "elkjs": "0.12.0",
    "highlight.js": "11.11.2",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "parse5": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
