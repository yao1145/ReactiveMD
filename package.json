{
  "name": "reactive-md",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["demo"],
  "files": ["dist-library", "README.md", "docs", "examples"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "npm run build:lib && npm run dev --workspace=@reactive-md/demo",
    "dev:lib": "vite build --config vite.lib.config.ts --watch",
    "build": "npm run typecheck && npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/generate-reference.mjs",
    "build:demo": "npm run build && npm run build --workspace=@reactive-md/demo",
    "preview": "npm run preview --workspace=@reactive-md/demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:demo": "npm run build:lib && npm run test --workspace=@reactive-md/demo",
    "test:browser": "npm run test:browser --workspace=@reactive-md/demo",
    "test:intelligent": "npm run test:intelligent --workspace=@reactive-md/demo",
    "test:package": "node scripts/verify-package.mjs",
    "test:docs": "node scripts/verify-docs.mjs"
  },
  "exports": {
    ".": { "types": "./dist-library/types/index.d.ts", "import": "./dist-library/reactive-md.js" },
    "./core": { "types": "./dist-library/types/core/index.d.ts", "import": "./dist-library/reactive-md.js" },
    "./react": { "types": "./dist-library/types/react/index.d.ts", "import": "./dist-library/reactive-md-react.js" },
    "./styles.css": "./dist-library/reactive-md.css",
    "./manifest.json": "./dist-library/components.json"
  },
  "dependencies": {
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
