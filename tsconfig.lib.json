{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-library/types",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/observability.ts",
    "src/local/transport/worker-pool.ts",
    "src/react/index.ts",
    "src/react/minimal.tsx",
    "src/react/packed.tsx",
    "src/react/runtime/index.ts",
    "src/runtime-services/index.ts",
    "src/runtime-services/browser/index.ts",
    "src/react/server.tsx",
    "src/authoring/index.ts",
    "src/sdk/index.ts",
    "src/contracts/index.ts",
    "src/presets/default.ts",
    "src/presets/packs.ts",
    "src/presets/pack-style-manifest.ts",
    "src/presets/minimal.ts",
    "src/components/minimal-preset.ts",
    "src/components/plugins/*.ts",
    "src/components/packs/*.ts",
    "src/pdf.ts",
    "src/export/index.ts",
    "src/export-assets/index.ts",
    "src/standalone/library.ts",
    "src/standalone/host.tsx",
    "src/build/index.ts",
    "src/testing/index.ts",
    "src/testing/react.tsx",
    "src/testing/browser.ts",
    "src/vite/index.ts",
    "src/compiler/index.ts",
    "src/compiler/standard.ts",
    "src/compiler/session.ts",
    "src/scan/index.ts"
