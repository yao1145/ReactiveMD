{
  "name": "reactive-md-sci-fi-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SCI-FI / SF-01 — a hard-sci-fi design system theme for Reactive MD.",
  "license": "MIT",
  "files": ["src", "docs", "README.md", "README-ch.md"],
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme.ts",
    "./styles.css": "./src/sci-fi.css",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reactive-md": "^0.8.0"
  }
}
