{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "reactive-md/styles.css": ["../../src/styles.css"],
      "reactive-md/react": ["../../src/react/index.ts"],
      "reactive-md/sdk": ["../../src/sdk/index.ts"],
      "reactive-md": ["../../src/index.ts"]
    }
  },
  "include": ["src", "demo"]
}
