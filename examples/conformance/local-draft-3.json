    {
      "id": "dynamic-date-min-follows-departure",
      "component": "date",
      "source": "<date bind=\"departure\" label=\"Departure\" initial=\"2026-11-10\">\n<date bind=\"return\" label=\"Return\" initial=\"2026-11-12\" min=\"{{ departure }}\">",
      "ok": true,
      "initial": {
        "departure": "2026-11-10",
        "return": "2026-11-12"
      },
      "bindingNames": [
        "departure",
        "return"
      ],
      "codes": [],
      "actions": [
        {
          "bind": "return",
          "value": "2026-11-01",
          "codes": [
            "local.runtime.value"
          ]
        }
      ],
      "text": "{{ return }}",
      "expectedText": "2026-11-12"
    },
    {
