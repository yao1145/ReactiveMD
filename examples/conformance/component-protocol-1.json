    {
      "id": "slider-explicit-initial",
      "component": "slider",
      "source": "<slider bind=\"seats\" label=\"People\" initial=\"2\" min=\"1\" max=\"20\">\n\nCurrently {{ seats }} people.",
      "ok": true,
      "codes": [],
      "initial": {
        "seats": 2
      },
      "bindingNames": [
        "seats"
      ],
      "text": "Currently {{ seats }} people.",
      "expectedText": "Currently 2 people.",
      "htmlIncludes": [
        "People"
      ]
    },
