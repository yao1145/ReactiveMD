    {
      "id": "tabs-hidden-controls-and-panel-reset",
      "component": "tabs",
      "source": "<panel title=\"Settings\">\n<tabs bind=\"view\" label=\"Sections\" initial=\"basic\">\n<tab label=\"Basic\" value=\"basic\">\n<slider bind=\"a\" label=\"A\" initial=\"2\" min=\"0\" max=\"10\">\n</tab>\n<tab label=\"Advanced\" value=\"advanced\">\n<slider bind=\"b\" label=\"B\" initial=\"7\" min=\"0\" max=\"10\">\n</tab>\n</tabs>\n</panel>",
      "ok": true,
      "codes": [],
      "initial": {
        "view": "basic",
        "a": 2,
        "b": 7
      },
      "bindingNames": [
        "a",
        "b",
        "view"
      ],
      "actions": [
        {
          "bind": "view",
          "value": "advanced",
          "codes": [],
          "expectedState": {
            "view": "advanced",
            "a": 2,
            "b": 7
          }
        },
        {
          "bind": "a",
          "value": 5,
          "codes": [],
          "expectedState": {
            "view": "advanced",
            "a": 5,
            "b": 7
          }
        },
        {
          "bind": "b",
          "value": 9,
          "codes": [],
          "expectedState": {
            "view": "advanced",
            "a": 5,
            "b": 9
          }
        }
      ],
      "reset": {
        "component": "panel",
        "expectedState": {
          "view": "basic",
          "a": 2,
          "b": 7
        }
      },
      "text": "{{ view }}: {{ a }} / {{ b }}",
      "expectedText": "basic: 2 / 7"
    },
