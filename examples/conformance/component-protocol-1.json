      "source": "<slider bind=\"seats\" label=\"人数\" initial=\"2\" min=\"1\" max=\"20\">\n\n当前 {{ seats }} 人。",
      "ok": true,
      "codes": [],
      "initial": { "seats": 2 },
      "bindingNames": ["seats"],
      "text": "当前 {{ seats }} 人。",
      "expectedText": "当前 2 人。",
      "htmlIncludes": ["人数"]
    },
