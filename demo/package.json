{
  "name": "reactive-md-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Playground and interactive article showcase for Reactive MD.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:browser": "npm run test:editor && npm run test:export",
    "test:browser:smoke": "node scripts/smoke-browser.mjs",
    "test:editor": "node scripts/verify-editor-scroll.mjs && node scripts/verify-editor-views.mjs && node scripts/verify-source-navigation.mjs",
    "test:toolbar": "node scripts/verify-editor-toolbar.mjs",
    "test:interactions": "node scripts/verify-editor-interactions.mjs",
    "test:export": "node scripts/verify-export.mjs && node scripts/verify-image-assets.mjs",
    "test:extensions": "node scripts/verify-extensions.mjs",
    "test:outline": "node scripts/verify-outline.mjs",
    "test:workbench": "node scripts/verify-compact-workbench.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reactive-md": "file:vendor/reactive-md-0.8.0-next.0-d3ede7a98fc8.tgz",
    "reactive-md-editor": "file:vendor/reactive-md-editor-0.1.0-next.0-4a47efdf9d2e.tgz",
    "reactive-md-game-2048-package": "file:vendor/reactive-md-game-2048-package-0.1.0-811733537169.tgz",
    "reactive-md-tetris-package": "file:vendor/reactive-md-tetris-package-0.1.0-1d7d5c9bd55d.tgz"
  },
  "devDependencies": {
    "@codemirror/view": "6.43.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
