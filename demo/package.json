  "dependencies": {
    "reactive-md": "file:..",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
